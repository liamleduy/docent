{
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/docent\" hook session-start" }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/docent\" hook prompt" }] }
    ],
    "PreToolUse": [
      { "matcher": "Read|Grep|Glob", "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/docent\" hook pre-tool-use" }] }
    ],
    "SubagentStop": [
      { "matcher": "docent:helper", "hooks": [{ "type": "command", "async": true, "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/docent\" hook subagent-stop" }] }
    ]
  }
}
